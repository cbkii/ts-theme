{
  "schema_version": 1,
  "product_name": "TS18 Launcher",
  "asset_stem": "TS18-Launcher",
  "application_id": "com.cbkii.ts18launcher",
  "module": "launcher",
  "gradle_task": ":launcher:assembleRelease",
  "apk_path": "launcher/build/outputs/apk/release/launcher-release.apk",
  "version_file": "gradle.properties",
  "version_name_property": "VERSION_NAME",
  "version_code_property": "VERSION_CODE",
  "install_tools": [
    "scripts/termux/README.md",
    "scripts/termux/install-standalone-launcher.sh",
    "docs/STANDALONE_LAUNCHER.md"
  ],
  "sdk": {
    "min": 29,
    "target": 29,
    "compile": 29
  },
  "native_abis": [],
  "required_apk_entries": [
    "AndroidManifest.xml",
    "assets/licenses/MATERIAL_SYMBOLS_NOTICE.txt",
    "assets/nav/nav-window.sh"
  ],
  "required_dex_classes": [
    "Lcom/cbkii/ts18launcher/LauncherActivity;",
    "Lcom/cbkii/ts18launcher/MediaListenerService;"
  ]
}
